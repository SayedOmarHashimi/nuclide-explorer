# Secrets - never commit
.env
.env.local
.env.*.local
*.pem

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# dbt
dbt/nuclide/target/
dbt/nuclide/dbt_packages/
dbt/nuclide/logs/
logs/

# Raw data snapshots. Regenerated by pipeline/ingest.py; kept out of git so
# history does not accumulate ~900KB per refresh.
data/raw/**/*.csv
data/raw/**/*.json

# Node / Next
node_modules/
.next/
out/
build/
.vercel/
*.tsbuildinfo
next-env.d.ts

# OS
.DS_Store

# dbt local user id (machine-specific)
dbt/nuclide/.user.yml
