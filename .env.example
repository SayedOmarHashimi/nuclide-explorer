# Copy to .env and fill in. .env is gitignored and must never be committed.

# Neon (or any Postgres) connection string, used by the pipeline and the API.
# Neon gives you this under "Connection Details" - use the pooled connection
# string for the web app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# dbt reads these separately because its postgres adapter takes discrete
# fields rather than a URL. They describe the same database as DATABASE_URL.
PGHOST=ep-example-123456.us-east-2.aws.neon.tech
PGUSER=neondb_owner
PGPASSWORD=replace-me
PGDATABASE=neondb
PGPORT=5432
PGSSLMODE=require

# Comma-separated origins allowed to call the API cross-origin. Localhost is
# added automatically outside production.
ALLOWED_ORIGINS=https://nuclide-explorer.vercel.app
